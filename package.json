{
  "name": "datum.net",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:astro": "astro dev --host --typecheck",
    "build:astro": "astro check --skip-playwright && astro build",
    "dev": "pnpm run dev:astro",
    "build": "pnpm run build:astro",
    "build:cache": "tsx scripts/warmup-cache.ts",
    "start": "node ./server.mjs",
    "start:dev": "node --env-file=.env ./server.mjs",
    "start:original": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint \"src/content/**/*.{md,mdx}\"",
    "lint:md:fix": "markdownlint \"src/content/**/*.{md,mdx}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,astro,md,mdx,json,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,astro,md,mdx,json,css,scss}\"",
    "prepare": "husky",
    "typecheck": "astro check",
    "precommit": "pnpm run typecheck && pnpm run lint && pnpm run lint:md",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:server": "node --test tests/server.test.mjs",
    "test:changelog": "node --test tests/changelogMdx.test.ts tests/changelogView.test.ts",
    "test:newsletter": "node --test tests/datumServiceAccount.test.ts",
    "test:article": "node --test tests/articleHeadings.test.ts tests/markdownFigure.test.ts"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.17.5",
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/node": "^11.1.14",
    "@astrojs/rss": "^4.0.19",
    "@datum-cloud/strapi-revalidate": "^0.3.1",
    "@expressive-code/core": "^0.44.4",
    "@kubernetes/client-node": "^1.4.0",
    "@lucide/astro": "^1.41.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "@octokit/graphql": "^9.0.5",
    "@octokit/types": "^17.0.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.13",
    "astro-breadcrumbs": "^3.4.2",
    "astro-compress": "^2.4.3",
    "astro-compressor": "^1.3.0",
    "astro-mermaid": "^2.2.0",
    "astro-seo": "^1.2.0",
    "braces": "file:vendor/braces",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "ioredis": "^6.0.0",
    "marked": "^18.3.0",
    "mermaid": "^11.17.2",
    "postgres": "^3.4.9",
    "rehype-expressive-code": "^0.44.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sirv": "^3.0.2",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.11.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/alpinejs": "^3.17.0",
    "@types/alpinejs__collapse": "^3.13.4",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^13.1.0",
    "shx": "^0.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.63.6"
  },
  "lint-staged": {
    "*": [
      "secretlint --maskSecrets"
    ],
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "markdownlint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.23.0"
}
