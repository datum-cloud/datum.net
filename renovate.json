{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>datum-cloud/.github:renovate-config"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump",
      "updateLockFiles": true
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "npm dependencies (safe)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm dependencies (major)"
    },
    {
      "description": "Block eslint major upgrades until eslint-plugin-jsx-a11y supports eslint v10",
      "matchPackageNames": ["eslint", "@eslint/js"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
