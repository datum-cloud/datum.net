---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Icon from '@components/Icon.astro';

export interface Props {
  faq: CollectionEntry<'faq'>;
  index: number;
  /** Keeps the answer permanently open, with no toggle and no plus/minus icon. */
  expanded?: boolean;
}

const { faq, index, expanded = false } = Astro.props;
const { Content } = await render(faq);
const faqContentId = `faq-content-${faq.id}`;

// Alpine attributes are spread because the Astro formatter cannot parse `@click`
// inside a conditional JSX branch.
const toggleAttrs = {
  '@click': `expandedFaq = expandedFaq === ${index} ? null : ${index}`,
  ':aria-expanded': `expandedFaq === ${index}`,
};
const contentAttrs = {
  ':aria-hidden': `expandedFaq !== ${index}`,
  'x-show': `expandedFaq === ${index}`,
  'x-collapse': '',
};
---

{
  expanded ? (
    <div class="faq-item" data-faq-id={faq.id}>
      <div class="faq-item--header">
        <span class="faq-item--question">{faq.data.question}</span>
      </div>

      <div class="faq-item--content">
        <div class="faq-item--content-wrapper">
          <Content />
        </div>
      </div>
    </div>
  ) : (
    <div class="faq-item" data-faq-id={faq.id}>
      <button class="faq-item--toggle" aria-controls={faqContentId} {...toggleAttrs}>
        <span class="faq-item--question">{faq.data.question}</span>
        <div class="faq-item--icon">
          <Icon name="plus" class="faq-item--icon-plus" />
          <Icon name="minus" class="faq-item--icon-minus" />
        </div>
      </button>

      <div class="faq-item--content" id={faqContentId} {...contentAttrs}>
        <div class="faq-item--content-wrapper">
          <Content />
        </div>
      </div>
    </div>
  )
}
