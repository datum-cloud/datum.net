---
// src/components/Footer.astro
import '@styles/components-modal.css';
import { Image } from 'astro:assets';
import navigation from '@data/navigation.json';
import type { NavData, NavFooterCard, NavItem } from '@/src/types/navigation';
import type { FooterProps } from '@/src/types/common';
import { filterNavFooterCards, filterNavFooterSections } from '@utils/navigationUtils';
import ImageFooter from '@assets/images/footer-illustration.png';
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import SectionEyebrow from '@components/SectionEyebrow.astro';
import ImageTwoMen from '@assets/images/two-person-talking.png';
import NewsletterModal from '@components/forms/NewsletterModal.astro';
import FooterAiAgents from '@components/FooterAiAgents.astro';
import FooterPrefooterGrid from '@assets/svgs/footer-prefooter-grid.svg';

const {
  class: className = '',
  showCTA = true,
  showBackground = true,
  showIllustration = false,
  showSignup = true,
  plainIllustration = false,
  illustrationBgClass = 'bg-glacier-mist-700',
  ctaTitle = 'go anywhere',
  ctaTitleAccent = 'Start here,',
  ctaDescription = 'Own more of your stack, reduce latency across regions, and connect privately with customers.',
  ctaButtons = [
    {
      text: 'Start for free',
      href: 'https://auth.datum.net/id/signup',
      class: 'btn btn--midnight-fjord btn--glow-aurora',
      icon: { name: 'arrow-right', size: 'md' },
      target: '_blank',
      event: 'Pre-footer: Start for free',
    },
    {
      text: 'Request a demo',
      href: '/demo',
      class: 'btn btn--alpha',
      event: 'Pre-footer: Request a demo',
    },
  ],
} = Astro.props as FooterProps;

const navData = navigation as NavData;
const footerCards = filterNavFooterCards(navData.footerCards);
const [platformSection, resourcesSection, companySection] = filterNavFooterSections(navData.footer);
---

<footer
  id="footer"
  class:list={[
    'footer relative bg-white text-white',
    !showCTA && 'pt-3 md:pt-0',
    !showBackground && 'bg-midnight-fjord',
    className,
  ]}
>
  {
    showCTA && (
      <div class="footer-prefooter px-4 sm:px-7" data-module-wipe>
        <span class="module-border-wipe" aria-hidden="true" />
        <div class="max-width-nav relative">
          <span class="section-line section-line--left section-line--top" />
          <SectionEyebrow variant="midnight-fjord" position="left-top">
            Get started
          </SectionEyebrow>

          <div class="footer-prefooter-grid" aria-hidden="true">
            <FooterPrefooterGrid class="line-draw pointer-events-none" />
          </div>
          <div class="max-width-nopad flex flex-col items-center gap-5.5 pt-14 text-center md:gap-10 md:pt-24 lg:pt-28 xl:pt-32 2xl:pt-40">
            <h2 class="section--title">
              <span class="text-pine-forge---links">{ctaTitleAccent}</span> {ctaTitle}
            </h2>
            <p class="datum-text-xl max-w-5xl text-pretty opacity-80">{ctaDescription}</p>
            <div class="flex items-center justify-center gap-4">
              {ctaButtons.map((button) => (
                <Button
                  class={button.class}
                  text={button.text}
                  icon={button.icon}
                  iconPosition="right"
                  iconClass="stroke-1.5"
                  target={button.target}
                  href={button.href}
                  data-rybbit-event={button.event}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    showBackground && (
      <div
        class:list={[
          'footer-illustration-container',
          !showCTA &&
            !plainIllustration &&
            `${illustrationBgClass} pt-12 md:pt-20 lg:pt-24 xl:pt-30`,
          plainIllustration && 'footer-illustration-container--plain',
        ]}
      >
        <div class="relative w-full">
          <Image
            src={ImageFooter}
            layout="constrained"
            alt="Footer illustration"
            class="relative mr-auto size-auto w-full -translate-y-3 object-cover"
          />
        </div>
      </div>
    )
  }

  {
    showIllustration && (
      <div class="3xl:right-55 2-5xl:right-50 absolute -top-23.5 right-15 z-10 hidden lg:right-25 lg:inline-block">
        <Image src={ImageTwoMen} alt="Two Person Talking" class="relative h-auto w-19.75" />
      </div>
    )
  }

  <div class="bg-midnight-fjord relative">
    <div class="footer-main">
      <div class="footer-grid">
        <div class="footer-cards">
          {
            footerCards.map((card: NavFooterCard) => (
              <a
                href={card.href}
                class="footer-card"
                target={card.isExternal ? '_blank' : undefined}
                rel={card.isExternal ? 'noopener noreferrer' : undefined}
                data-astro-prefetch={card.isExternal ? undefined : 'hover'}
              >
                <Icon name={card.icon} size="lg" class="footer-card-icon" />
                <span class="footer-card-content">
                  <span class="footer-card-title">{card.title}</span>
                  <span class="footer-card-description">{card.description}</span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="footer-nav-container" role="navigation">
          {
            platformSection && (
              <div class="footer-nav-section">
                <p class="footer-nav-header">{platformSection.title}</p>
                <ul class="footer-nav-list">
                  {platformSection.items.map((item: NavItem) => (
                    <li>
                      <a
                        href={item.href}
                        class="footer-nav-link"
                        target={item.isExternal ? '_blank' : undefined}
                        rel={item.isExternal ? 'noopener noreferrer' : undefined}
                        data-astro-prefetch="hover"
                        title={item.text}
                        tabindex="0"
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            resourcesSection && (
              <div class="footer-nav-section">
                <p class="footer-nav-header">{resourcesSection.title}</p>
                <ul class="footer-nav-list">
                  {resourcesSection.items.map((item: NavItem) => (
                    <li>
                      <a
                        href={item.href}
                        class="footer-nav-link"
                        target={item.isExternal ? '_blank' : undefined}
                        rel={item.isExternal ? 'noopener noreferrer' : undefined}
                        data-astro-prefetch="hover"
                        title={item.text}
                        tabindex="0"
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            companySection && (
              <div class="footer-nav-section">
                <p class="footer-nav-header">{companySection.title}</p>
                <ul class="footer-nav-list">
                  {companySection.items.map((item: NavItem) => (
                    <li>
                      <a
                        href={item.href}
                        class="footer-nav-link"
                        target={item.isExternal ? '_blank' : undefined}
                        rel={item.isExternal ? 'noopener noreferrer' : undefined}
                        data-astro-prefetch="hover"
                        title={item.text}
                        tabindex="0"
                      >
                        {item.text}
                      </a>
                      {item.label && <span class="nav-label">{item.label}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="footer-nav-section">
            <p class="footer-nav-header">Status</p>
            <div
              id="hyperping-badge"
              class="footer-status-badge datum-docs-sidebar-headings text-glacier-mist-700 [&>div]:bg-logo-object/15 min-w-[140px] normal-case [&>div]:rounded-md [&>div]:px-2 [&>div]:py-1"
            >
            </div>
          </div>
        </div>
      </div>

      <FooterAiAgents social={navData.social} />
    </div>
  </div>

  {
    showSignup && (
      <div
        id="footer-signup"
        class="bg-blush-quartz text-midnight-fjord py-9 md:py-10 lg:py-12 xl:py-20"
      >
        <div class="max-width flex w-full max-w-190 grow flex-col items-center gap-4 md:w-auto md:max-w-none md:gap-11 lg:gap-13.5">
          <h3 class="datum-text-7xl mb-0">Let's stay connected, shall we?</h3>

          <div data-newsletter-trigger>
            <Button
              class="btn btn--alpha"
              text="Get our monthly email"
              icon={{ name: 'arrow-right', size: 'md' }}
              iconPosition="right"
              iconClass="stroke-1.5"
              href="#"
            />
          </div>
        </div>
      </div>
    )
  }

  <NewsletterModal />
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll('[data-newsletter-trigger]');
    if (!triggers.length) return;
    const openNewsletterModal = () => {
      if (window.NEWSLETTER_MODAL_OPEN_EVENT) {
        document.dispatchEvent(new CustomEvent(window.NEWSLETTER_MODAL_OPEN_EVENT));
      }
    };
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const label = trigger.getAttribute('data-newsletter-rybbit') || 'Footer: Newsletter Signup';
        if (window.rybbit) window.rybbit.event(label);
        openNewsletterModal();
      });
    });
  });
</script>
