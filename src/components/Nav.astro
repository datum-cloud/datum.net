---
import Logo from '@assets/svgs/datum-logo-h.svg';
import MobileMenu from '@components/MobileMenu.astro';
import Icon from '@components/Icon.astro';
import LogoDropdown from '@components/LogoDropdown.astro';
import NavMenu from '@components/NavMenu.astro';
import type { NavProps } from '@/src/types/common';

const { class: className = '' } = Astro.props as NavProps;
const cloudPortalUrl =
  process.env.PUBLIC_CLOUD_PORTAL_URL ||
  import.meta.env.PUBLIC_CLOUD_PORTAL_URL ||
  'https://cloud.datum.net/';
---

<section class:list={['nav--main-container relative', className]}>
  <nav class="nav--main" role="navigation" aria-label="Main navigation">
    {/* Logo */}

    <div class="nav-logo-container">
      <a href="/" class="nav-logo" id="logo-link" aria-label="Datum Logo" title="Datum Logo">
        <Logo />
      </a>

      {/* Logo Download Dropdown */}
      <LogoDropdown id="logo-dropdown" triggerElementId="logo-link" />
    </div>

    {/* Desktop Menu */}
    <NavMenu />

    {/* Desktop Actions */}
    <div class="nav-actions">
      <a
        href={cloudPortalUrl}
        class="nav-cta-signin"
        data-rybbit-event="Nav: Sign in"
        data-portal-user-link
      >
        <img
          alt=""
          width="24"
          height="24"
          class="hidden size-6 rounded-full object-cover"
          referrerpolicy="no-referrer"
          data-portal-user-avatar
        />
        <span data-portal-user-label>Sign in</span>
        <Icon
          name="log-in"
          size="md"
          class="nav-signin-icon text-canyon-clay hidden lg:inline-flex"
        />
      </a>

      <a
        href="https://auth.datum.net/id/signup"
        class="nav-cta-demo"
        target="_blank"
        data-rybbit-event="Nav: Start for free"
      >
        {/* Mobile shows "Start"; sr-only keeps full text for SEO/a11y (Lighthouse). */}
        <span class="inline-flex lg:hidden">Start<span class="sr-only"> for free</span></span>
        <span class="hidden lg:inline-flex">Start for free</span>
        <Icon name="arrow-right" size="md" class="hidden lg:inline-flex" />
      </a>
    </div>

    {/* Mobile menu — inside <template> so it is inert in static HTML and invisible to crawlers */}
    <template id="mobile-menu-template">
      <MobileMenu />
    </template>
    <div id="mobile-menu-mount" class="md:hidden"></div>
    <script is:inline>
      (function () {
        var tpl = document.getElementById('mobile-menu-template');
        var mount = document.getElementById('mobile-menu-mount');
        if (tpl && mount) mount.appendChild(tpl.content.cloneNode(true));
      })();
    </script>
  </nav>

  <div class="nav-dropdown-backdrop" aria-hidden="true"></div>
</section>

<script>
  let navBackdropRaf = 0;
  let lastNavBackdropTop = '';

  const syncNavDropdownBackdropTop = () => {
    if (navBackdropRaf) return;
    navBackdropRaf = requestAnimationFrame(() => {
      navBackdropRaf = 0;
      const container = document.querySelector('.nav--main-container');
      if (!container) return;
      const next = `${container.getBoundingClientRect().bottom}px`;
      if (next === lastNavBackdropTop) return;
      lastNavBackdropTop = next;
      document.documentElement.style.setProperty('--nav-dropdown-backdrop-top', next);
    });
  };

  const initNavDropdownBackdropTop = () => {
    const container = document.querySelector('.nav--main-container');
    if (!container) return;

    syncNavDropdownBackdropTop();

    // ResizeObserver + window resize cover nav/announcement height changes.
    // Scroll is omitted: sticky nav bottom edge does not move with scrollY.
    window.addEventListener('resize', syncNavDropdownBackdropTop, { passive: true });
    new ResizeObserver(syncNavDropdownBackdropTop).observe(container);

    const announcement = document.getElementById('announcement');
    if (announcement) {
      new ResizeObserver(syncNavDropdownBackdropTop).observe(announcement);
    }
  };

  initNavDropdownBackdropTop();
  document.addEventListener('alpine:initialized', syncNavDropdownBackdropTop);

  // Shape of cloud-portal GET /api/website/session-status.
  type SessionStatus =
    | { signedIn: false }
    | {
        signedIn: true;
        user: { displayName: string; avatarUrl?: string };
        dashboardUrl: string;
      };

  // Shows the cloud-portal user's name and avatar in place of "Sign in" on the
  // desktop and mobile menu links, and points them at the user's dashboard.
  // Relies on the browser sending cloud-portal's _session cookie (same-site
  // with datum.net) and on this origin being in cloud-portal's WEBSITE_ORIGINS.
  const loadPortalUser = async () => {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-portal-user-link]');
    if (!links.length) return;

    try {
      const portal = new URL(links[0].href);
      const res = await fetch(new URL('/api/website/session-status', portal), {
        credentials: 'include',
      });
      if (!res.ok) return;
      const status = (await res.json()) as SessionStatus;
      if (!status.signedIn) return;

      const name = status.user.displayName;
      const avatarUrl = status.user.avatarUrl?.startsWith('https://')
        ? status.user.avatarUrl
        : null;
      // Only follow dashboard links that stay on the portal.
      const dashboardUrl =
        new URL(status.dashboardUrl, portal).origin === portal.origin ? status.dashboardUrl : null;

      links.forEach((link) => {
        if (dashboardUrl) link.href = dashboardUrl;

        const label = link.querySelector<HTMLElement>('[data-portal-user-label]');
        if (label && name) label.textContent = name;

        const avatar = link.querySelector<HTMLImageElement>('[data-portal-user-avatar]');
        if (avatar && avatarUrl) {
          avatar.src = avatarUrl;
          avatar.alt = name;
          avatar.classList.remove('hidden');
          link.querySelector('.nav-signin-icon')?.remove();
        }
      });
    } catch {
      // Blocked until this origin is in cloud-portal's WEBSITE_ORIGINS; keep "Sign in".
    }
  };

  loadPortalUser();
</script>
