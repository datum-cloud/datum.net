---
// src/components/SectionLine.astro
// Decorative corner grid lines for section containers

import type { SectionLineProps } from '@/src/types/common';

const {
  left = false,
  right = false,
  top = false,
  bottom = false,
  overlap = false,
  extended = false,
  bottomOverlap = false,
  class: className = '',
} = Astro.props as SectionLineProps;

const corners: Array<{ horizontal: 'left' | 'right'; vertical: 'top' | 'bottom' }> = [];

if (left && top) corners.push({ horizontal: 'left', vertical: 'top' });
if (left && bottom) corners.push({ horizontal: 'left', vertical: 'bottom' });
if (right && top) corners.push({ horizontal: 'right', vertical: 'top' });
if (right && bottom) corners.push({ horizontal: 'right', vertical: 'bottom' });
---

{
  corners.map(({ horizontal, vertical }) => {
    const isBottomOverlapCorner = bottomOverlap && horizontal === 'right' && vertical === 'bottom';

    if (isBottomOverlapCorner) {
      return (
        <>
          <span
            aria-hidden="true"
            class:list={[
              'section-line',
              'section-line--right',
              'section-line--bottom-overlap',
              className,
            ]}
          />
          <span
            aria-hidden="true"
            class:list={[
              'section-line-h',
              'section-line-h--bottom-overlap',
              'section-line--right',
              'section-line--bottom',
              className,
            ]}
          />
        </>
      );
    }

    if (extended) {
      return (
        <>
          <span
            aria-hidden="true"
            class:list={[
              'section-line',
              'section-line--extended',
              horizontal === 'left' && 'section-line--left',
              horizontal === 'right' && 'section-line--right',
              vertical === 'top' && 'section-line--top',
              vertical === 'bottom' && 'section-line--bottom',
              className,
            ]}
          />
          <span
            aria-hidden="true"
            class:list={[
              'section-line-h',
              'section-line-h--extended',
              horizontal === 'left' && 'section-line--left',
              horizontal === 'right' && 'section-line--right',
              vertical === 'top' && 'section-line--top',
              vertical === 'bottom' && 'section-line--bottom',
              className,
            ]}
          />
        </>
      );
    }

    if (overlap) {
      return (
        <>
          <span
            aria-hidden="true"
            class:list={[
              'section-line--overlap',
              horizontal === 'left' && 'section-line--left',
              horizontal === 'right' && 'section-line--right',
              vertical === 'top' && 'section-line--top',
              vertical === 'bottom' && 'section-line--bottom',
              className,
            ]}
          />
          <span
            aria-hidden="true"
            class:list={[
              'section-line-h--overlap',
              horizontal === 'left' && 'section-line--left',
              horizontal === 'right' && 'section-line--right',
              vertical === 'top' && 'section-line--top',
              vertical === 'bottom' && 'section-line--bottom',
              className,
            ]}
          />
        </>
      );
    }

    return (
      <span
        aria-hidden="true"
        class:list={[
          'section-line',
          horizontal === 'left' && 'section-line--left',
          horizontal === 'right' && 'section-line--right',
          vertical === 'top' && 'section-line--top',
          vertical === 'bottom' && 'section-line--bottom',
          className,
        ]}
      />
    );
  })
}
