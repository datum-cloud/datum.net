---
// src/components/Tooltip.astro

import Icon from '@components/Icon.astro';
import type { TooltipProps } from '@/src/types/common';

const {
  id,
  text,
  label,
  triggerLabel = 'More information',
  class: className = '',
} = Astro.props as TooltipProps;
---

<span
  class:list={['tooltip', className]}
  x-data="infoTooltip()"
  @pointerenter="showHover($event)"
  @pointerleave="hideHover($event)"
  @click.outside="close()"
  @keydown.escape.window="close()"
>
  <button
    type="button"
    class="tooltip-trigger"
    x-ref="trigger"
    aria-label={triggerLabel}
    aria-describedby={id}
    :aria-expanded="open"
    @pointerdown="notePointer($event)"
    @pointercancel="cancelGesture()"
    @click="onClick()"
    @focus="onFocus($event)"
    @blur="onBlur()"
  >
    <Icon name="info" class="tooltip-trigger-icon" />
  </button>

  <span
    class="tooltip-bubble"
    id={id}
    role="tooltip"
    x-ref="bubble"
    x-cloak
    x-show="open"
    x-transition.opacity
  >
    <span class="tooltip-text">
      {label && <strong class="tooltip-label">{label}</strong>}
      {text}
    </span>
    <span class="tooltip-arrow" x-ref="arrow" aria-hidden="true"></span>
  </span>
</span>
