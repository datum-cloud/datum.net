---
// src/components/about/PeopleStrapi.astro
import { getStrapiTeamMembers, getTeamBgColor, getAvatarVariantBgColor } from '@libs/strapi';
import { getStrapiMediaUrl } from '@/src/types/strapi';
import type { StrapiAuthorFull } from '@libs/strapi';
import ProfileModal from './ProfileModal.astro';
import SectionLine from '@components/SectionLine.astro';
import ModuleConnector from '@components/home/ModuleConnector.astro';
import '@styles/page-about.css';

// Fetch all team members from Strapi (authors where isTeam is true)
// This uses caching - team members are cached for 5 minutes by default
const teamMembers: StrapiAuthorFull[] = await getStrapiTeamMembers();

// Background color matching each person's actual headshot variant (detected
// from the avatar file name), not their position in the list — the roster
// gets reordered every time someone joins or leaves, but the photo's baked-in
// backdrop never does. Falls back to the old index cycle only for an avatar
// that predates the variant-suffix naming convention. Computed once here so
// the grid card and the profile modal never disagree with each other.
const avatarBgColors = teamMembers.map(
  (member, index) => getAvatarVariantBgColor(member.avatar?.url) ?? getTeamBgColor(index)
);

// Prepare team member data for client-side modal (serialize data)
const teamMembersData = teamMembers.map((member, index) => ({
  id: member.documentId,
  slug: member.slug || member.documentId,
  data: {
    name: member.name,
    bio: member.bio,
    title: member.title,
    avatar: member.avatar ? { src: getStrapiMediaUrl(member.avatar.url) } : undefined,
    avatarBgColor: avatarBgColors[index],
    tick: member.tick,
    surprising: member.surprising,
    weekends: member.weekends,
  },
}));
---

<div class="relative">
  <section class="section--block section--block--x-pad bg-glacier-mist-700">
    <div class="max-width-nav relative py-10 md:py-16 lg:py-20 xl:py-28">
      <SectionLine left top />
      <div class="max-width-nopad relative z-10">
        <h3 class="datum-text-8xl mx-auto mb-8 max-w-sm text-center md:max-w-md lg:mb-10">
          Meet the people behind Datum
        </h3>

        <p
          class="datum-text-lg mx-auto mb-8 max-w-sm text-center md:mb-12 lg:mb-16 lg:max-w-lg xl:mb-21"
        >
          We are infrastructure, open source software, and design nerds who love building for the
          future.
        </p>

        {
          teamMembers.length === 0 ? (
            <div class="py-12 text-center">
              <p class="text-gray-500">No team members found.</p>
            </div>
          ) : (
            <div class="grid grid-cols-2 gap-6 md:grid-cols-4 xl:grid-cols-5">
              {teamMembers.map((member, index) => (
                <button
                  class="people--card"
                  data-member-trigger
                  data-member-index={index}
                  type="button"
                  tabindex={0}
                  aria-label={`View ${member.name}'s profile`}
                >
                  {member.avatar && (
                    <div class="people--card-avatar">
                      <img
                        src={getStrapiMediaUrl(member.avatar.url)}
                        alt={member.name}
                        class="size-auto w-full bg-cover"
                        style={`background-color: ${avatarBgColors[index]}`}
                      />
                      {/* Check if member.title contains "Co-Founder" and show Founder label */}
                      {member.title && member.title.includes('Co-Founder') && (
                        <span class="people--card-founder-label">Founder</span>
                      )}
                    </div>
                  )}

                  <h4 class="people--card-name">{member.name}</h4>

                  <div class="people--card-title">{member.title && <p>{member.title}</p>}</div>
                </button>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <ProfileModal />
  </section>
  <ModuleConnector />
</div>

<script is:inline define:vars={{ teamMembersData }}>
  const teamData = teamMembersData;

  function dispatchOpen(member) {
    document.dispatchEvent(
      new CustomEvent(window.PROFILE_MODAL_OPEN_EVENT, { detail: { member } })
    );
  }

  function openBySlug(slug) {
    if (!slug || !window.PROFILE_MODAL_OPEN_EVENT) return;
    const member = teamData.find((m) => m.slug === slug);
    if (member) dispatchOpen(member);
  }

  // Initialize event listeners - runs immediately since server island content is already in DOM
  (function init() {
    document.querySelectorAll('[data-member-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        const index = parseInt(e.currentTarget.getAttribute('data-member-index') || '0', 10);
        const member = teamData[index];
        if (member && window.PROFILE_MODAL_OPEN_EVENT) dispatchOpen(member);
      });
    });

    // Deep-link: server island runs before ProfileModal's bundled module script,
    // so wait for the custom element to be defined (which also sets PROFILE_MODAL_OPEN_EVENT).
    customElements.whenDefined('profile-modal').then(() => {
      const hash = window.location.hash.slice(1);
      if (hash) openBySlug(hash);
    });
  })();
</script>
