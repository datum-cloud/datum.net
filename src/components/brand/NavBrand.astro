---
// src/components/brand/NavBrand.astro
import navigation from '@data/navigation.json';
import type { NavData, NavFooterSection, NavItem } from '@/src/types/navigation';

const { currentPath } = Astro.props;

const navData = navigation as NavData;
const navBrand = navData.brand;

const allItems: NavItem[] =
  navBrand?.flatMap((section: NavFooterSection) => section.items ?? []) ?? [];

const currentTitle = allItems.find((item) => item.href === currentPath)?.text ?? 'Menu';
---

<aside
  class="legal-sidenav pt-0"
  x-data="{ open: false }"
  @click.away="open = false"
  @resize.window="if (window.innerWidth >= 768) open = false"
>
  <button
    class="legal-sidenav-toggle md:hidden"
    @click="open = !open"
    :aria-expanded="open"
    aria-controls="brand-nav-menu"
  >
    <span class="legal-sidenav-toggle--text">{currentTitle}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="legal-sidenav-toggle--icon"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <nav id="brand-nav-menu" class="legal-sidenav-menu" x-show="open" x-transition x-cloak>
    {
      allItems.map((item: NavItem) => (
        <a
          href={item.href}
          class:list={[
            'legal-sidenav-item',
            { 'legal-sidenav-item--active': item.href === currentPath },
          ]}
          data-astro-prefetch="hover"
          @click="open = false"
        >
          {item.text}
        </a>
      ))
    }
  </nav>
</aside>
