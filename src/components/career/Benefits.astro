---
// src/components/career/Benefits.astro
// "Open by design" — what to expect working at Datum. Figma node 17529:87537.
import Icon from '@components/Icon.astro';
import SectionEyebrow from '@components/SectionEyebrow.astro';
import SectionLine from '@components/SectionLine.astro';
import ModuleConnector from '@components/home/ModuleConnector.astro';

const benefits = [
  {
    icon: 'calendar-check-2',
    title: 'Flexible working hours',
    description:
      'While we love to work, a lot happens outside of traditional working hours. We trust our people to show up and get their job done– a 9-5 may not work for everyone.',
  },
  {
    icon: 'map-pin',
    title: 'Remote first',
    description:
      "Designed with distributed in mind, we're a global team that spans multiple timezones.",
  },
  {
    icon: 'piggy-bank',
    title: 'Competitive compensation',
    description:
      'Clear bands for salary and equity to ensure our team is aligned and focused on our mission.',
  },
  {
    icon: 'backpack',
    title: 'Flexible PTO',
    description: 'No use it or lose it, take the time you need when you need it.',
  },
  {
    icon: 'scan-heart',
    title: 'Health coverage',
    description:
      'We have a competitive benefits package to make sure you and your family are covered.',
  },
  {
    icon: 'blend',
    title: 'Open & transparent',
    description:
      "From our work in open source to transparent metrics about the company's finances and performance, we're all in it together.",
  },
];
---

<div class="relative">
  <section
    id="benefits"
    class="border-silver-keyline section--block section--block--x-pad border-b bg-white"
  >
    <div class="max-width-nav career-section-pad relative">
      <SectionLine left right top bottom />
      <div class="spacing-pad">
        <div class="career-benefits-inner">
          <header class="career-section-header">
            <SectionEyebrow>Open by design</SectionEyebrow>
            <h2 class="career-section-title">What to expect working here</h2>
          </header>

          <ul class="career-benefits-card">
            {
              benefits.map((benefit) => (
                <li class="career-benefit">
                  <span class="career-benefit-icon">
                    <Icon name={benefit.icon} size="md" />
                  </span>
                  <div class="career-benefit-text">
                    <h3 class="career-benefit-title">{benefit.title}</h3>
                    <p class="career-benefit-description">{benefit.description}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
  <ModuleConnector />
</div>
