---
// src/components/career/Culture.astro
// "A culture shaped by our mission" — intro on the left, values card on the
// right. Figma node 17529:87512.
import { Image } from 'astro:assets';
import grid from '@assets/svgs/career-culture-grid.svg';
import SectionEyebrow from '@components/SectionEyebrow.astro';
import SectionLine from '@components/SectionLine.astro';
import ModuleConnector from '@components/home/ModuleConnector.astro';

const groups = [
  {
    title: 'Who we are',
    items: [
      'We are connectors — of people, businesses,\napps and networks.',
      'We are operators at heart',
      'We are passionate about working in the open',
    ],
  },
  {
    title: 'How we act',
    items: [
      'We find creative answers to hard problems',
      'We prioritize outcomes for users, customers,\nand partners',
      'We write our own words',
    ],
  },
];
---

<div class="relative">
  <section
    id="culture-shaped"
    class="bg-platinum border-app---dark---utility-5 section--block section--block--x-pad overflow-clip border-b"
  >
    <div class="max-width-nav large-pad relative">
      <SectionLine left right top />
      <div class="spacing-pad">
        <div class="career-culture-content">
          <div class="career-culture-intro">
            <SectionEyebrow>About Datum</SectionEyebrow>
            <div class="career-culture-heading">
              <h2 class="career-culture-title">
                A culture shaped by<br class="hidden lg:inline" /> our mission
              </h2>
              <p class="career-culture-lead">
                People first and purpose driven, we are dedicated to connecting others to their
                advantage. We strive to balance a sense of humility with a strong conviction for
                what’s next.
              </p>
            </div>
          </div>

          <div class="career-culture-card">
            <Image src={grid} alt="" class="career-culture-card-grid" />

            {
              groups.map((group) => (
                <div class="career-culture-group">
                  <h3 class="career-culture-group-title">{group.title}</h3>
                  <ul class="career-culture-list">
                    {group.items.map((item) => (
                      <li>
                        {item.split('\n').map((line, index) => (
                          <>
                            {index > 0 && <br class="hidden md:inline" />}
                            {index > 0 && ' '}
                            {line}
                          </>
                        ))}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }

            <p class="career-culture-more">
              Read more about
              <a href="/handbook/culture/" class="career-culture-link">how we work</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <ModuleConnector />
</div>
