---
// src/components/career/Mission.astro
// Careers hero: illustration on the left, eyebrow / title / lead / CTA on the
// right. Title and lead come from src/content/pages/career.mdx.
// Figma node 17529:82312.
import illustration from '@content/careers/images/careers.png';
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Button from '@components/Button.astro';
import SectionEyebrow from '@components/SectionEyebrow.astro';
import SectionLine from '@components/SectionLine.astro';
import ModuleConnector from '@components/home/ModuleConnector.astro';

const { content } = Astro.props as { content: CollectionEntry<'pages'> };
const { Content } = await render(content);
---

<div class="relative">
  <section id="mission" class="career-mission section--block section--block--x-pad">
    <div class="max-width-nav large-pad relative">
      <SectionLine left right top bottom />
      <div class="spacing-pad">
        <div class="career-mission-content">
          <div class="career-mission-media">
            <Image
              src={illustration}
              alt="Illustrated portraits of the Datum team"
              widths={[572, 1144]}
              sizes="(min-width: 1024px) 572px, 100vw"
              loading="eager"
            />
          </div>
          <div class="career-mission-copy">
            <SectionEyebrow>Work with us</SectionEyebrow>
            <div class="career-mission-text">
              <h1 class="career-mission-title">{content.data.title}</h1>
              <div class="career-mission-lead">
                <Content />
              </div>
            </div>
            <Button
              href="#roles"
              class="btn btn--alpha btn--sm career-mission-cta"
              text="View open roles"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
<ModuleConnector />
