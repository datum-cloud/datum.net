---
export const prerender = false;

import { marked } from 'marked';
import Icon from '@components/Icon.astro';
import ChangelogDot from '@assets/icons/changelog-dot.svg';
import { changelogs, type ChangelogProps } from '@/src/libs/datum';

const entries = await changelogs();

// GitHub renders bare media URLs (uploaded via the issue/discussion editor) as
// inline video players. `marked` only autolinks them, so we convert those
// anchors into <video> players. Images stay as <img> tags and are untouched,
// since only bare URLs — not the `![alt](...)`/`<img>` syntax — match here.
function embedGithubVideos(html: string): string {
  return html.replace(
    /<a href="(https:\/\/github\.com\/user-attachments\/assets\/[a-f0-9-]+|https?:\/\/[^"]+\.(?:mp4|mov|webm|ogv|ogg))"[^>]*>[^<]*<\/a>/gi,
    (_match, url: string) =>
      `<video class="changelog-entry-card-video" controls preload="metadata" playsinline src="${url}"></video>`
  );
}
---

<div class="changelog-toolbar">
  <button type="button" class="changelog-toolbar-sort" data-changelog-sort data-order="recent">
    <Icon name="list-filter" size="sm" class="size-4.5!" />
    <span>Sort by: <span data-changelog-sort-label>Recent</span></span>
  </button>
  <div class="changelog-toolbar-search" data-changelog-search-root>
    <label class="changelog-toolbar-search-field">
      <Icon name="search" size="sm" class="size-4.5!" />
      <span class="sr-only">Search changelog</span>
      <input
        type="search"
        placeholder="Search"
        data-changelog-search
        autocomplete="off"
        role="combobox"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls="changelog-search-results"
      />
    </label>
    <ul
      id="changelog-search-results"
      class="changelog-search-results"
      role="listbox"
      aria-label="Changelog results"
      data-changelog-results
      hidden
    >
    </ul>
    <p class="sr-only" role="status" data-changelog-status></p>
  </div>
</div>

<div class="changelog-list" data-changelog-list>
  {
    entries.map((entry: ChangelogProps, index: number) => (
      <div
        id={`changelog-${entry.id}`}
        class:list={['changelog-entry', { 'changelog-entry--last': index === entries.length - 1 }]}
      >
        <div class="changelog-entry-line" />

        <div class="changelog-entry-sidebar">
          <div class="changelog-entry-dot">
            <ChangelogDot aria-hidden="true" />
          </div>
          <div class="changelog-entry-nav-content">
            <h3 class="changelog-entry-nav-title">{entry.title}</h3>
            <div class="changelog-entry-nav-date-row">
              <time class="changelog-entry-nav-date">
                {new Date(entry.createdAt).toLocaleDateString('en-US', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                })}
              </time>
            </div>
          </div>
        </div>

        <article class="changelog-entry-card">
          <div class="changelog-entry-card-header">
            <a
              href={entry.url}
              target="_blank"
              rel="noopener noreferrer"
              class="changelog-entry-card-link"
            >
              <span>View on GitHub</span>
              <Icon name="external-link" size="md" />
            </a>
          </div>
          <div
            class="changelog-entry-card-body"
            set:html={embedGithubVideos(marked.parse(entry.body) as string)}
          />

          {entry.labels && entry.labels.nodes.length > 0 && (
            <div class="changelog-entry-card-tags">
              {entry.labels.nodes.map((label) => (
                <div class="changelog-entry-card-tag-row">
                  <span
                    class={`changelog-entry-card-tag changelog-entry-card-tag--${label.name.toLowerCase()}`}
                  >
                    {label.name}
                  </span>
                  {label.description && (
                    <span class="changelog-entry-card-tag-description">{label.description}</span>
                  )}
                </div>
              ))}
            </div>
          )}
        </article>
      </div>
    ))
  }
</div>

<script>
  // The list arrives after page load through server:defer, so everything is delegated from
  // document (and derived from the DOM) instead of bound to elements that do not exist yet.
  const OPTION_ID_PREFIX = 'changelog-option-';
  const ENTRY_ID_PREFIX = 'changelog-';
  const FLASH_MS = 1800;

  interface SearchResult {
    entry: HTMLElement;
    title: string;
    date: string;
    snippet: string;
  }

  let results: SearchResult[] = [];
  let activeIndex = -1;
  let query = '';

  function changelogList(): HTMLElement | null {
    return document.querySelector<HTMLElement>('[data-changelog-list]');
  }

  function searchParts() {
    const root = document.querySelector<HTMLElement>('[data-changelog-search-root]');
    const input = root?.querySelector<HTMLInputElement>('[data-changelog-search]');
    const listbox = root?.querySelector<HTMLElement>('[data-changelog-results]');
    const status = root?.querySelector<HTMLElement>('[data-changelog-status]');
    return root && input && listbox && status ? { root, input, listbox, status } : null;
  }

  function markLastEntry(list: HTMLElement) {
    const entries = Array.from(list.querySelectorAll<HTMLElement>('.changelog-entry'));
    for (const entry of entries) entry.classList.remove('changelog-entry--last');
    entries.at(-1)?.classList.add('changelog-entry--last');
  }

  // ---- search ------------------------------------------------------------------------------

  function findResults(rawQuery: string): SearchResult[] {
    const list = changelogList();
    const needle = rawQuery.trim().toLowerCase();
    if (!list || !needle) return [];

    const found: SearchResult[] = [];
    for (const entry of list.querySelectorAll<HTMLElement>('.changelog-entry')) {
      const title = entry.querySelector('.changelog-entry-nav-title')?.textContent?.trim() ?? '';
      const date = entry.querySelector('time')?.textContent?.trim() ?? '';
      const body = (entry.querySelector('.changelog-entry-card-body')?.textContent ?? '')
        .replace(/\s+/g, ' ')
        .trim();
      const tags = entry.querySelector('.changelog-entry-card-tags')?.textContent ?? '';

      const inTitle = title.toLowerCase().includes(needle);
      const bodyIndex = body.toLowerCase().indexOf(needle);
      const matches =
        inTitle ||
        bodyIndex >= 0 ||
        date.toLowerCase().includes(needle) ||
        tags.toLowerCase().includes(needle);
      if (!matches) continue;

      // Show where the text matched when it isn't visible in the title.
      let snippet = '';
      if (!inTitle && bodyIndex >= 0) {
        const start = Math.max(0, bodyIndex - 40);
        const end = Math.min(body.length, bodyIndex + needle.length + 80);
        snippet = `${start > 0 ? '…' : ''}${body.slice(start, end)}${end < body.length ? '…' : ''}`;
      }
      found.push({ entry, title, date, snippet });
    }
    return found;
  }

  // Appends `text` to `parent`, wrapping matches of `needle` in <mark> (text nodes only: safe).
  function appendHighlighted(parent: HTMLElement, text: string, needle: string) {
    const lower = text.toLowerCase();
    const n = needle.toLowerCase();
    let from = 0;
    while (n) {
      const at = lower.indexOf(n, from);
      if (at < 0) break;
      if (at > from) parent.append(text.slice(from, at));
      const mark = document.createElement('mark');
      mark.textContent = text.slice(at, at + n.length);
      parent.append(mark);
      from = at + n.length;
    }
    if (from < text.length) parent.append(text.slice(from));
  }

  function setExpanded(expanded: boolean) {
    const parts = searchParts();
    if (!parts) return;
    parts.listbox.hidden = !expanded;
    parts.input.setAttribute('aria-expanded', String(expanded));
    if (!expanded) parts.input.removeAttribute('aria-activedescendant');
  }

  function closeResults() {
    activeIndex = -1;
    setExpanded(false);
  }

  function setActive(index: number, scroll = true) {
    const parts = searchParts();
    if (!parts) return;
    activeIndex = index;
    const options = parts.listbox.querySelectorAll<HTMLElement>('[role="option"]');
    options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
    const active = options[index];
    if (active) {
      parts.input.setAttribute('aria-activedescendant', active.id);
      if (scroll) active.scrollIntoView({ block: 'nearest' });
    } else {
      parts.input.removeAttribute('aria-activedescendant');
    }
  }

  function renderResults() {
    const parts = searchParts();
    if (!parts) return;
    query = parts.input.value.trim();
    results = findResults(query);
    activeIndex = -1;
    parts.listbox.textContent = '';

    if (!query) {
      parts.status.textContent = '';
      closeResults();
      return;
    }

    results.forEach((result, index) => {
      const option = document.createElement('li');
      option.id = `${OPTION_ID_PREFIX}${index}`;
      option.className = 'changelog-search-option';
      option.setAttribute('role', 'option');
      option.setAttribute('aria-selected', 'false');
      option.dataset.index = String(index);

      const title = document.createElement('span');
      title.className = 'changelog-search-option-title';
      appendHighlighted(title, result.title, query);
      option.append(title);

      if (result.date) {
        const date = document.createElement('span');
        date.className = 'changelog-search-option-date';
        date.textContent = result.date;
        option.append(date);
      }
      if (result.snippet) {
        const snippet = document.createElement('span');
        snippet.className = 'changelog-search-option-snippet';
        appendHighlighted(snippet, result.snippet, query);
        option.append(snippet);
      }
      parts.listbox.append(option);
    });

    if (results.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'changelog-search-empty';
      empty.setAttribute('role', 'presentation');
      empty.textContent = 'No matching changes.';
      parts.listbox.append(empty);
    }

    parts.status.textContent =
      results.length === 0
        ? 'No matching changes.'
        : `${results.length} result${results.length === 1 ? '' : 's'} available. Use up and down arrows to review.`;
    setExpanded(true);
  }

  // ---- navigation --------------------------------------------------------------------------

  function flash(entry: HTMLElement) {
    entry.classList.remove('changelog-entry--flash');
    void entry.offsetWidth; // restart the animation if it is already running
    entry.classList.add('changelog-entry--flash');
    window.setTimeout(() => entry.classList.remove('changelog-entry--flash'), FLASH_MS);
  }

  function goToEntry(entry: HTMLElement, updateHash = true) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    entry.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    if (updateHash) history.replaceState(null, '', `#${entry.id}`);
    flash(entry);
  }

  function selectResult(index: number) {
    const result = results[index];
    if (!result) return;
    closeResults();
    goToEntry(result.entry);
  }

  function entryFromHash(): HTMLElement | null {
    let id = '';
    try {
      id = decodeURIComponent(location.hash.slice(1));
    } catch {
      return null;
    }
    return id.startsWith(ENTRY_ID_PREFIX) ? document.getElementById(id) : null;
  }

  // A deep link (#changelog-…) can't be scrolled to natively because the entries arrive after
  // load, so wait for them and then scroll.
  function scrollToHashWhenReady() {
    const attempt = () => {
      if (!changelogList()) return false;
      const entry = entryFromHash();
      if (entry) goToEntry(entry, false);
      return true;
    };
    if (!location.hash.startsWith(`#${ENTRY_ID_PREFIX}`) || attempt()) return;
    const observer = new MutationObserver(() => {
      if (attempt()) observer.disconnect();
    });
    observer.observe(document.body, { childList: true, subtree: true });
    window.setTimeout(() => observer.disconnect(), 15000);
  }

  // ---- events ------------------------------------------------------------------------------

  function onClick(event: MouseEvent) {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const option = target.closest<HTMLElement>('.changelog-search-option');
    if (option) {
      selectResult(Number(option.dataset.index));
      return;
    }
    if (!target.closest('[data-changelog-search-root]')) closeResults();

    const sort = target.closest<HTMLButtonElement>('[data-changelog-sort]');
    const list = changelogList();
    if (!sort || !list) return;

    const next = sort.dataset.order === 'recent' ? 'oldest' : 'recent';
    sort.dataset.order = next;
    const label = sort.querySelector<HTMLElement>('[data-changelog-sort-label]');
    if (label) label.textContent = next === 'recent' ? 'Recent' : 'Oldest';
    list.append(...Array.from(list.children).reverse());
    markLastEntry(list);
  }

  function onInput(event: Event) {
    if ((event.target as HTMLElement | null)?.matches?.('[data-changelog-search]')) renderResults();
  }

  function onFocusIn(event: FocusEvent) {
    const input = event.target as HTMLInputElement | null;
    if (input?.matches?.('[data-changelog-search]') && input.value.trim()) renderResults();
  }

  function onKeyDown(event: KeyboardEvent) {
    const input = event.target as HTMLInputElement | null;
    if (!input?.matches?.('[data-changelog-search]')) return;
    const parts = searchParts();
    if (!parts) return;
    const open = !parts.listbox.hidden;

    switch (event.key) {
      case 'ArrowDown':
      case 'ArrowUp': {
        event.preventDefault();
        if (!open) renderResults();
        if (results.length === 0) return;
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const next =
          activeIndex < 0
            ? step === 1
              ? 0
              : results.length - 1
            : (activeIndex + step + results.length) % results.length;
        setActive(next);
        break;
      }
      case 'Enter':
        if (open && results.length > 0) {
          event.preventDefault();
          selectResult(activeIndex >= 0 ? activeIndex : 0);
        }
        break;
      case 'Escape':
        if (open) {
          event.preventDefault(); // close the list first; a second Esc clears the field
          closeResults();
        }
        break;
      case 'Tab':
        closeResults();
        break;
    }
  }

  // Keep focus in the input while the pointer is on the list (so the click still registers).
  function onMouseDown(event: MouseEvent) {
    if ((event.target as HTMLElement | null)?.closest?.('[data-changelog-results]')) {
      event.preventDefault();
    }
  }

  function onMouseMove(event: MouseEvent) {
    const option = (event.target as HTMLElement | null)?.closest<HTMLElement>(
      '.changelog-search-option'
    );
    if (option) {
      const index = Number(option.dataset.index);
      if (index !== activeIndex) setActive(index, false);
    }
  }

  const changelogHook = globalThis as typeof globalThis & { __changelogToolbar?: boolean };
  if (!changelogHook.__changelogToolbar) {
    changelogHook.__changelogToolbar = true;
    document.addEventListener('click', onClick);
    document.addEventListener('input', onInput);
    // Esc on a type="search" field clears it and fires `search` (not `input`). `search` is not
    // reliably bubbled across browsers, so capture it.
    document.addEventListener('search', onInput, true);
    document.addEventListener('focusin', onFocusIn);
    document.addEventListener('keydown', onKeyDown);
    document.addEventListener('mousedown', onMouseDown);
    document.addEventListener('mousemove', onMouseMove);
    window.addEventListener('hashchange', scrollToHashWhenReady);
    document.addEventListener('astro:page-load', scrollToHashWhenReady);
  }
  scrollToHashWhenReady();
</script>
