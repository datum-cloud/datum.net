---
import SectionEyebrow from '@components/SectionEyebrow.astro';
import SectionLine from '@components/SectionLine.astro';
import Icon from '@components/Icon.astro';
import { builtForYou } from '@data/dedicatedCloud';
---

<section
  class="section--block section--block--x-pad border-silver-mist bg-platinum relative overflow-hidden border-t"
>
  <div class="max-width-nav large-pad relative">
    <SectionEyebrow position="left-top">{builtForYou.eyebrow}</SectionEyebrow>
    <SectionLine left top bottom />
    <SectionLine right top />

    <div class="max-width-nopad">
      <div class="grid grid-cols-6 gap-10 md:gap-12 lg:gap-16 xl:gap-16">
        <div class="col-span-6 flex flex-col gap-6 md:col-span-2">
          <h2 class="section-title--sm text-midnight-fjord">{builtForYou.title}</h2>
          <div class="text-app---dark---utility-3 datum-text-base flex flex-col gap-4">
            {builtForYou.intro.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>

        <div
          class="border-silver-mist bg-silver-mist col-span-6 grid grid-cols-1 gap-px border sm:grid-cols-2 md:col-span-4"
        >
          {
            builtForYou.items.map((item) => (
              <div class="bg-platinum flex flex-col items-start gap-4 p-6 lg:p-8">
                <div class="bg-aurora-moss flex size-10 shrink-0 items-center justify-center rounded-sm">
                  <Icon name={item.icon} size="sm" class="text-pine-forge---links" />
                </div>
                <div class="flex flex-col gap-1">
                  <p class="datum-text-lg text-midnight-fjord font-semibold">{item.title}</p>
                  <p class="datum-text-base text-app---dark---utility-3">{item.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
