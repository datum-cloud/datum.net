---
import SectionEyebrow from '@components/SectionEyebrow.astro';
import SectionLine from '@components/SectionLine.astro';
import Icon from '@components/Icon.astro';
import {
  fetchStrapiAuthorBySlug,
  getHelloPineForgeAvatarUrl,
  getStrapiMediaUrl,
} from '@libs/strapi';
import { operators, whyDatum } from '@data/dedicatedCloud';
import ModuleConnector from '@components/home/ModuleConnector.astro';
import DigitalRealtyLogo from '@assets/logos/dc-partners/digitalrealty.svg';
import EquinixLogo from '@assets/logos/dc-partners/equinix.svg';
import DatabankLogo from '@assets/logos/dc-partners/databank.svg';
import SabeyLogo from '@assets/logos/dc-partners/sabey.svg';
import QtsLogo from '@assets/logos/dc-partners/qts.svg';

const DC_PARTNER_LOGOS = [
  { name: 'Digital Realty', Logo: DigitalRealtyLogo, class: 'h-14' },
  { name: 'Equinix', Logo: EquinixLogo, class: 'h-7' },
  { name: 'DataBank', Logo: DatabankLogo, class: 'h-7' },
  { name: 'Sabey Data Centers', Logo: SabeyLogo, class: 'h-8' },
  { name: 'QTS', Logo: QtsLogo, class: 'h-6' },
];

function initials(name: string): string {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

// Only the pine-forge variant is used: its backdrop is baked in at upload time
// and is the one that matches this section's tile color. The shared
// `Author.avatar` field is deliberately not a fallback — it points at whichever
// variant /about needs, and a canyon-clay or glacier-mist backdrop reads as a
// clashing square here. Anyone without a pine-forge upload gets an initials tile.
const people = await Promise.all(
  operators.items.map(async (person) => {
    const author = await fetchStrapiAuthorBySlug(person.slug);
    const pineForgePath = await getHelloPineForgeAvatarUrl(person.slug);
    return {
      ...person,
      avatarUrl: pineForgePath ? getStrapiMediaUrl(pineForgePath) : null,
      linkedinUrl: person.linkedin ?? author?.social?.linkedin ?? null,
    };
  })
);
---

<section
  class="section--block section--block--x-pad bg-pine-forge border-silver-mist relative overflow-hidden border-b"
>
  <div class="max-width-nav large-pad relative">
    <SectionEyebrow variant="aurora-moss" position="left-top">
      {operators.eyebrow}
    </SectionEyebrow>

    <SectionLine left top bottom class="bg-pine-forge-keyline" />

    <div class="max-width-nopad relative py-4 md:py-6">
      <ul
        class="border-pine-forge-keyline bg-silver-mist/50 grid grid-cols-1 gap-px border sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          people.map((person) => (
            <li class="bg-pine-forge flex flex-col items-start gap-7 p-8 lg:p-10">
              {person.avatarUrl ? (
                <img
                  src={person.avatarUrl}
                  alt={person.name}
                  class="bg-pine-forge-tile aspect-square w-full object-cover"
                />
              ) : (
                <div
                  class="bg-pine-forge-tile flex aspect-square w-full items-center justify-center"
                  aria-hidden="true"
                >
                  <span class="datum-text-3xl font-semibold text-white opacity-60">
                    {initials(person.name)}
                  </span>
                </div>
              )}
              <div class="flex flex-col gap-2.5">
                <div class="flex flex-col">
                  <p class="datum-text-lg font-semibold text-white">{person.name}</p>
                  <p class="datum-text-xs text-aurora-moss font-dejavu uppercase">{person.role}</p>
                </div>
                <p class="datum-text-sm text-white/80">{person.bio}</p>
              </div>
              {person.linkedinUrl && (
                <a
                  href={person.linkedinUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="datum-text-xs inline-flex items-center gap-2 text-white transition-opacity hover:opacity-80"
                >
                  <Icon name="linkedin" size="sm" class="size-4" />
                  LinkedIn
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="max-width-nopad relative mt-14 flex flex-wrap items-center justify-center gap-8 md:mt-20 md:gap-16"
    >
      <p class="datum-text-sm font-dejavu text-center text-white/80 uppercase">
        {whyDatum.tagline}
      </p>
      <span class="hidden h-8 w-px bg-white/30 md:block" aria-hidden="true"></span>
      <ul class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 xl:gap-x-16">
        {
          DC_PARTNER_LOGOS.map(({ name, Logo, class: heightClass }) => (
            <li class="flex items-center opacity-80">
              <Logo class:list={['w-auto', heightClass]} aria-label={name} role="img" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <ModuleConnector barClass="bg-pine-forge-keyline" />
</section>
