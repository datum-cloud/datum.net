---
// src/components/dns/HeroAnimation.astro
// Looping 7-step DNS import walkthrough for the hero visual — GitHub issue #1571.
// Frames come from Figma section 15907:15701; the 28s timing is transcribed from
// the motion data on the sibling "DNS Import - Animated" node (15930:4131).
//
// Chrome + cards are split from one sprite into HTML layers so we can blur the
// dashboard via a real HTML wrapper (CSS filter on SVG <g> is unreliable).

import spriteRaw from '@assets/features/dns-hero/dns-hero-sprite.svg?raw';
import { hero } from '@data/dns';

const STAGE_ATTRS =
  'xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="598" height="368" viewBox="0 0 598 368" fill="none" class="dns-hero-anim-svg" role="presentation" aria-hidden="true"';

/**
 * Pull a marked section out of the generated sprite and wrap it as a mini SVG.
 * @param raw - Full sprite source
 * @param name - Marker name (`chrome` | `cards`)
 */
const extractLayer = (raw: string, name: 'chrome' | 'cards'): string => {
  const start = `<!--dns-hero:${name}:start-->`;
  const end = `<!--dns-hero:${name}:end-->`;
  const from = raw.indexOf(start);
  const to = raw.indexOf(end);
  if (from === -1 || to === -1 || to <= from) {
    throw new Error(`dns-hero sprite missing ${name} markers`);
  }
  const inner = raw.slice(from + start.length, to).trim();
  return `<svg ${STAGE_ATTRS}>\n${inner}\n</svg>`;
};

const chromeMarkup = extractLayer(spriteRaw, 'chrome');
const cardsMarkup = extractLayer(spriteRaw, 'cards');
---

<div class="dns-hero-anim" role="img" aria-label={hero.imageAlt}>
  <div class="dns-hero-anim-stage" aria-hidden="true">
    <div class="dns-hero-anim-chrome" set:html={chromeMarkup} />
    <div class="dns-hero-anim-frost"></div>
    <div class="dns-hero-anim-cards" set:html={cardsMarkup} />
  </div>
</div>
