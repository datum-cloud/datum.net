---
// src/components/pricing/Faq.astro
// FAQ block for /pricing. Reuses the shared FAQ item in its `expanded` mode —
// the design shows every answer open with no toggle affordance. Figma node
// 18493:88896.

import { getCollection } from 'astro:content';
import FAQ from '@components/FAQ.astro';
import SectionLine from '@components/SectionLine.astro';
import { faqTitle } from '@data/pricing';

const faqs = (await getCollection('faq'))
  .filter((faq) => !faq.data.draft && faq.data.category === 'pricing')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<section
  id="faq"
  class="section--block section--block--x-pad bg-platinum border-silver-keyline border-b"
  aria-labelledby="pricing-faq-title"
>
  <div class="max-width-nav spacing-pad relative py-16 md:py-20 lg:py-28">
    <SectionLine left right top />
    <SectionLine left bottom />

    <div class="pricing-faq">
      <h2 id="pricing-faq-title" class="pricing-faq-title">{faqTitle}</h2>

      <div class="faq-list pricing-faq-list">
        {faqs.map((faq, index) => <FAQ faq={faq} index={index} expanded />)}
      </div>
    </div>
  </div>
</section>
