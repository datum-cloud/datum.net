---
// src/components/pricing/RateTables.astro
// Rate section: beta notice, the two side-by-side rate cards and the
// always-free "batteries" card. Figma nodes 18493:88299 – 18493:88731.

import BetaBanner from '@components/pricing/BetaBanner.astro';
import Batteries from '@components/pricing/Batteries.astro';
import RateCard from '@components/pricing/RateCard.astro';
import SectionLine from '@components/SectionLine.astro';
import { rates } from '@data/pricing';
---

<section id="rates" class="section--block section--block--x-pad bg-white" aria-label="Rate card">
  <div class="max-width-nav spacing-pad relative pb-16 md:pb-24 lg:pb-40 xl:pb-60">
    <SectionLine left right bottom />

    <div class="pricing-rates">
      <BetaBanner />

      <div class="pricing-rates-cards">
        {rates.cards.map((card) => <RateCard card={card} />)}
      </div>

      <Batteries />
    </div>
  </div>
</section>
