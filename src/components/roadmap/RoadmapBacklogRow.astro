---
// src/components/roadmap/RoadmapBacklogRow.astro
import Icon from '@components/Icon.astro';
import type { GitHubBacklogItem } from '@libs/githubBacklog';

interface Props {
  item: GitHubBacklogItem;
}

const { item } = Astro.props as Props;
---

<article class="roadmap-item">
  <div class="roadmap-item--top">
    <div class="roadmap-item--text">
      <h3 class="roadmap-item--title">
        <button
          type="button"
          class="roadmap-item--trigger"
          data-roadmap-item={item.number}
          aria-haspopup="dialog"
        >
          {item.title}
        </button>
      </h3>
      {item.excerpt && <p class="roadmap-item--excerpt">{item.excerpt}</p>}
    </div>
    <a
      class="roadmap-item--external"
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Open #${item.number} on GitHub`}
    >
      <Icon name="external-link" size="sm" />
    </a>
  </div>
  {
    item.labels.length > 0 && (
      <ul class="roadmap-item--tags" data-roadmap-tags>
        {item.labels.map((label) => (
          <li class="roadmap-item--tag">{label}</li>
        ))}
      </ul>
    )
  }
</article>
