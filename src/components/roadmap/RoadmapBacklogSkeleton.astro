---
// src/components/roadmap/RoadmapBacklogSkeleton.astro
const COLUMNS = ['planning', 'onDeck', 'inProgress'] as const;
const ITEMS_PER_COLUMN = 3;
---

<section aria-label="Product roadmap" aria-busy="true" class="roadmap-board roadmap-skeleton">
  {
    COLUMNS.map((column) => (
      <div class="roadmap-column">
        <div class="roadmap-skeleton__heading">
          <span class={`roadmap-skeleton__dot roadmap-column--dot-${column}`} />
          <span class="skeleton-box roadmap-skeleton__heading-text" />
        </div>
        <ul class="roadmap-column--list">
          {Array.from({ length: ITEMS_PER_COLUMN }, (_, index) => (
            <li>
              <div class="roadmap-skeleton__item skeleton-item" data-index={String(index + 1)}>
                <span class="skeleton-box roadmap-skeleton__title" />
                <span class="skeleton-box roadmap-skeleton__excerpt" />
                <span class="skeleton-box roadmap-skeleton__tag" />
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>
