---
// src/components/roadmap/RoadmapCard.astro
import { Image } from 'astro:assets';
import type { RoadmapMilestone } from '@libs/githubRoadmap';
import {
  getRoadmapSlug,
  getMonthAbbreviation,
  getRoadmapCoverImage,
  getRoadmapReleaseName,
} from '@libs/githubRoadmap';
import { formatDate } from '@utils/dateUtils';

interface Props {
  roadmap: RoadmapMilestone;
}

const { roadmap } = Astro.props as Props;

const coverImage = getRoadmapCoverImage(roadmap.number);
const detailHref = coverImage ? `/releases/${getRoadmapSlug(roadmap)}` : undefined;
const releaseName = getRoadmapReleaseName(roadmap.title);
const releaseDate = formatDate(roadmap.releaseDate, 'en-US', { month: 'short', year: 'numeric' });
const monthAbbr = getMonthAbbreviation(roadmap.releaseDate);
const detailLabel = `View ${roadmap.title} release`;
---

<li class="roadmap-card">
  {
    detailHref && coverImage ? (
      <a href={detailHref} class="roadmap-card--image-wrap" aria-label={detailLabel}>
        <Image
          src={coverImage}
          alt={roadmap.title}
          class="roadmap-card--image"
          loading="lazy"
          decoding="async"
        />
      </a>
    ) : (
      <div class="roadmap-card--placeholder" aria-hidden="true">
        <span class="roadmap-card--placeholder-month">{monthAbbr}</span>
      </div>
    )
  }
  <p class="roadmap-card--label">
    <time datetime={roadmap.releaseDate} class="roadmap-card--label-date">{releaseDate}</time>
    {
      detailHref ? (
        <a href={detailHref} class="roadmap-card--label-name">
          {releaseName}
        </a>
      ) : (
        <span class="roadmap-card--label-name">{releaseName}</span>
      )
    }
  </p>
</li>
