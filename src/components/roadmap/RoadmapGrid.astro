---
// src/components/roadmap/RoadmapGrid.astro
import type { RoadmapMilestone } from '@libs/githubRoadmap';
import { getRoadmapCoverImage, groupRoadmapsByDate } from '@libs/githubRoadmap';
import Icon from '@components/Icon.astro';
import RoadmapCard from './RoadmapCard.astro';

interface Props {
  roadmaps: RoadmapMilestone[];
}

const { roadmaps } = Astro.props as Props;

const UPCOMING_LIMIT = 3;

const { upcoming: allUpcoming, previous: allPrevious } = groupRoadmapsByDate(roadmaps);
const previous = allPrevious.filter((roadmap) => getRoadmapCoverImage(roadmap.number));
const upcoming = allUpcoming.slice(0, UPCOMING_LIMIT);
---

{
  upcoming.length > 0 && (
    <section class="release-group" aria-labelledby="roadmap-upcoming-heading">
      <div class="release-group--header">
        <h2 id="roadmap-upcoming-heading" class="release-group--title">
          Upcoming releases
        </h2>
      </div>
      <ul class="roadmap-grid">
        {upcoming.map((roadmap) => (
          <RoadmapCard roadmap={roadmap} />
        ))}
      </ul>
    </section>
  )
}

{
  previous.length > 0 && (
    <section class="release-group" aria-labelledby="roadmap-past-heading" data-roadmap-past>
      <div class="release-group--header">
        <h2 id="roadmap-past-heading" class="release-group--title">
          Past releases
        </h2>
        <button type="button" class="release-sort" data-release-sort data-order="recent">
          <Icon name="list-filter" size="sm" class="size-4.5!" />
          <span>
            Sort by: <span data-release-sort-label>Recent</span>
          </span>
        </button>
      </div>
      <ul class="roadmap-grid" data-roadmap-past-list>
        {previous.map((roadmap) => (
          <RoadmapCard roadmap={roadmap} />
        ))}
      </ul>
    </section>
  )
}

{
  upcoming.length === 0 && previous.length === 0 && (
    <p class="release-empty">No releases available yet.</p>
  )
}

<script>
  const SORT_LABELS = { recent: 'Recent', oldest: 'Oldest' } as const;

  function initRoadmapSort() {
    const button = document.querySelector<HTMLButtonElement>('[data-release-sort]');
    const list = document.querySelector<HTMLUListElement>('[data-roadmap-past-list]');
    const label = button?.querySelector<HTMLElement>('[data-release-sort-label]');
    if (!button || !list || !label || button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';

    button.addEventListener('click', () => {
      const next = button.dataset.order === 'recent' ? 'oldest' : 'recent';
      button.dataset.order = next;
      label.textContent = SORT_LABELS[next];
      list.append(...Array.from(list.children).reverse());
    });
  }

  initRoadmapSort();
  document.addEventListener('astro:page-load', initRoadmapSort);
</script>
