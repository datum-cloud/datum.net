---
import '@styles/global.css';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import Footer from '@components/Footer.astro';
import Button from '@components/Button.astro';
import Image404 from '@assets/images/404.png';
import { Image } from 'astro:assets';

const title = "Sorry, we can't find that page";
const description = 'The page you are looking for does not exist.';
---

<Layout title={title} description={description} bodyClass="page-404">
  <section class="datum-container">
    <Hero class="light" title={title} />

    {
      /* bg-platinum, matching the Hero above it: the section previously used
        bg-glacier-mist-700 (#f6f6f5), a near-but-not-quite match for the
        Hero's bg-platinum (#f9f9f8) with nothing (no image/form) between
        them to break up the seam — read as an unintentional two-tone glitch
        rather than a deliberate section break. Same color = no seam, matching
        the pattern already used on /essentials and /developers. */
    }
    <div class="section--block bg-platinum pb-14 md:pb-20 lg:pb-28">
      <main class="mx-auto max-w-391 px-6">
        <Image src={Image404} alt="404" class="mx-auto mb-12 h-auto w-full max-w-[423px]" />
        <article class="prose prose-xl mx-auto text-center">
          <p class="mb-12">Please check the URL and try again.</p>
          <Button
            text="Return to homepage"
            href="/"
            class="btn btn--alpha mr-0 mb-4 md:mr-1 md:mb-0"
            icon={{ name: 'arrow-right', size: 'md' }}
          />
          <p class="page-404-recovery-links datum-text-sm text-midnight-fjord/60 mt-8">
            Or try the <a href="/sitemap.xml" class="hover:text-midnight-fjord underline">sitemap</a
            >,
            <a href="/llms.txt" class="hover:text-midnight-fjord underline">llms.txt</a>, or the
            <a href="/docs" class="hover:text-midnight-fjord underline">docs</a>.
          </p>
        </article>
      </main>
    </div>
    <Footer showCTA={false} showBackground={false} />
  </section>

  {
    import.meta.env.MODE === 'production' && (
      <script>import '@/src/static/scripts/error-tracker.js';</script>
    )
  }
</Layout>
