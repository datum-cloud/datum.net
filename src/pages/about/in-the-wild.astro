---
// src/pages/about/in-the-wild.astro
// In the wild — Figma node 17529:87624.

import '@styles/page-about.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '@layouts/Layout.astro';
import Footer from '@components/Footer.astro';
import Icon from '@components/Icon.astro';
import { inTheWild } from '@data/about';
import wordmark from '@assets/images/about/wild/wordmark.png';
import abFans from '@assets/images/about/wild/ab-fans.jpg';
import balticNog from '@assets/images/about/wild/baltic-nog.jpg';
import nerdingOut from '@assets/images/about/wild/nerding-out.jpg';
import abGame from '@assets/images/about/wild/ab-game.jpg';
import nerdsUnited from '@assets/images/about/wild/nerds-united.jpg';
import traveling from '@assets/images/about/wild/traveling.jpg';
import twins from '@assets/images/about/wild/twins.jpg';
import viktor from '@assets/images/about/wild/viktor.jpg';
import worksOnArm from '@assets/images/about/wild/works-on-arm.jpg';
import focus from '@assets/images/about/wild/focus.jpg';
import runChicago from '@assets/images/about/wild/run-chicago.jpg';

type WildId = (typeof inTheWild.columns)[number][number]['id'];

const images: Record<WildId, ImageMetadata> = {
  'ab-fans': abFans,
  'baltic-nog': balticNog,
  'nerding-out': nerdingOut,
  'ab-game': abGame,
  'nerds-united': nerdsUnited,
  traveling,
  twins,
  viktor,
  'works-on-arm': worksOnArm,
  focus,
  'run-chicago': runChicago,
};

const title = 'In the Wild';
const description = inTheWild.intro;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://www.datum.net/about/in-the-wild#webpage',
  url: 'https://www.datum.net/about/in-the-wild/',
  name: title,
  description,
  isPartOf: { '@id': 'https://www.datum.net/about#webpage' },
  about: { '@id': 'https://www.datum.net#organization' },
  inLanguage: 'en-US',
};
---

<Layout title={title} description={description} bodyClass="page-about" jsonLd={jsonLd}>
  <section class="datum-container">
    <section class="section--block section--block--x-pad bg-white">
      <div class="max-width-nav wild-page">
        <nav class="wild-crumbs" aria-label="Breadcrumb">
          <a href="/" aria-label="Home">
            <Icon name="house" size="sm" />
          </a>
          <span aria-hidden="true">/</span>
          <a href="/about">About</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{inTheWild.crumb}</span>
        </nav>

        <h1 class="wild-wordmark">
          <Image
            src={wordmark}
            alt={inTheWild.title}
            widths={[1192, 1788, 2442]}
            sizes="(min-width: 1024px) 596px, 90vw"
          />
        </h1>

        <div class="wild-intro">
          <hr class="wild-rule" />
          <div class="wild-intro-copy">
            <h2 class="wild-intro-title">
              {inTheWild.introTitle[0]}
              <br />
              {inTheWild.introTitle[1]}
            </h2>
            <p class="wild-intro-body">{inTheWild.intro}</p>
          </div>
          <hr class="wild-rule" />
        </div>

        <div class="wild-grid">
          {
            inTheWild.columns.map((column) => (
              <div class="wild-column">
                {column.map((story) => (
                  <article class="wild-card">
                    <div
                      class:list={[
                        'wild-card-media',
                        story.aspect === 'tall'
                          ? 'wild-card-media--tall'
                          : 'wild-card-media--short',
                      ]}
                      data-wild-pixel
                    >
                      <Image src={images[story.id]} alt="" />
                      <span class="wild-card-wash" aria-hidden="true" />
                      <span class="wild-card-mark" aria-hidden="true">
                        <Icon name="datum-logo" size="sm" />
                      </span>
                    </div>
                    <h3 class="wild-card-title">{story.title}</h3>
                    <p class="wild-card-description">{story.description}</p>
                  </article>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <Footer showCTA={false} illustrationBgClass="bg-white" />
  </section>
</Layout>

<script>
  import '@/src/static/scripts/module-wild-pixel.js';
</script>
