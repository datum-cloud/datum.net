---
// src/pages/blog.astro
export const prerender = false;

import '@styles/page-blog.css';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import Footer from '@components/Footer.astro';
import ModuleConnector from '@components/home/ModuleConnector.astro';
import SectionLine from '@components/SectionLine.astro';
import GlobalSection from '@components/GlobalSection.astro';
import BlogStrapiIndex from '@components/blog/BlogStrapi.astro';
import defaultOgImage from '@content/images/og/blog.png';
import { getCollectionEntry } from '@utils/collectionUtils';

// Get blog landing page from blog/index.mdx
const page = await getCollectionEntry('pages', 'blog');

const icon = 'book-image';

// SEO
const fm = page.data;
const meta = fm.meta || {};
const title = fm.title;
const description = fm.description ? fm.description : '';
const subtitle = fm.subtitle ? fm.subtitle : 'Blog';

// Set default blog OG image - always use blog.png
const blogMeta = {
  ...meta,
  og: {
    image: defaultOgImage,
    ...meta?.og,
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://www.datum.net/blog#webpage',
      url: 'https://www.datum.net/blog',
      name: 'Datum Blog – Updates on Alternative Cloud and AI Native Industry News',
      description:
        'Read the latest from the Datum team — product vision, engineering deep dives, open source strategy, and insights on the next wave of AI-native cloud platforms.',
      isPartOf: { '@id': 'https://www.datum.net/#organization' },
      inLanguage: 'en-US',
      dateModified: '2026-01-14',
    },
    {
      '@type': 'Blog',
      '@id': 'https://www.datum.net/blog#blog',
      name: 'Datum Blog',
      description:
        'Thoughts and updates from the Datum team — covering alternative cloud, AI-native infrastructure, open source strategy, Kubernetes control planes, and product direction.',
      url: 'https://www.datum.net/blog',
      publisher: { '@id': 'https://www.datum.net/#organization' },
      inLanguage: 'en-US',
    },
  ],
};
---

<Layout
  title={title || 'Datum'}
  description={description}
  bodyClass="page-blog"
  meta={blogMeta}
  jsonLd={jsonLd}
>
  <section class="datum-container">
    <div class="relative">
      <Hero
        class="light"
        iconName={icon}
        title={title}
        subtitle={subtitle}
        description={description}
        showSectionLines
        sectionLines={{ left: true, right: true, top: true }}
      />
      <ModuleConnector />
    </div>

    <div class="relative">
      <div class="section--block section--block--x-pad bg-midnight-fjord dark">
        <div class="max-width-nav relative py-10 md:py-16 lg:py-20 xl:py-28">
          <SectionLine left top bottom class="bg-app---dark---utility-2" />
          <div class="max-width">
            <BlogStrapiIndex page={1} />
          </div>
        </div>
      </div>
      <ModuleConnector barClass="bg-app---dark---utility-2" />
    </div>

    <GlobalSection />

    <Footer />
  </section>
</Layout>
