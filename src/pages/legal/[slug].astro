---
import '@styles/page-legal.css';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import Footer from '@components/Footer.astro';
import Sidebar from '@components/legal/Sidebar.astro';
import { getCollection, render } from 'astro:content';
import type { LegalNavItem } from '@/src/types/common';

export async function getStaticPaths() {
  const legal = await getCollection('legal');

  return legal.map((entry) => {
    return {
      params: {
        slug: entry.id,
      },
      props: { entry, legal },
    };
  });
}

const page = Astro.props.entry;
const allLegal = Astro.props.legal;

// SEO
const fm = page.data;
const meta = fm.meta || {};
const { Content } = await render(page);
const title = fm.title ? fm.title : 'Datum - Privacy Policy';
const description = fm.description;

// Sort side nav by frontmatter sidebar.order (content-editable, like handbook)
const sortedLegal = [...allLegal].sort(
  (a, b) => (a.data.sidebar?.order ?? 0) - (b.data.sidebar?.order ?? 0)
);

const navItems: LegalNavItem[] = await Promise.all(
  sortedLegal.map(async (entry) => {
    const { headings } = await render(entry);
    return {
      id: entry.id,
      title: entry.data.sidebar?.label || entry.data.title,
      headings: headings.map((heading) => ({
        slug: heading.slug,
        text: heading.text,
        depth: heading.depth,
      })),
    };
  })
);
---

<Layout
  title={title}
  description={description}
  bodyClass={`page-legal page-legal--${page.id}`}
  meta={meta}
>
  <section class="datum-container">
    <Hero
      class="light bg-glacier-mist-800 [&_.hero--main-content-title]:max-w-none"
      title={fm.title}
    />

    <div class="section--block section--block--small-pad bg-glacier-mist-700">
      <div class="max-width">
        <div class="legal-layout">
          <Sidebar items={navItems} currentId={page.id} />

          <main class="legal-content">
            <Content />
          </main>
        </div>
      </div>
    </div>

    <Footer showCTA={false} />
  </section>
</Layout>
