---
import '@styles/page-legal.css';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import Footer from '@components/Footer.astro';
import Sidebar from '@components/legal/Sidebar.astro';
import TableOfContents from '@components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';
import type { LegalNavItem } from '@/src/types/common';

export async function getStaticPaths() {
  const legal = await getCollection('legal', ({ data }) => !data.draft);

  return legal.map((entry) => {
    return {
      params: {
        slug: entry.id,
      },
      props: { entry, legal },
    };
  });
}

const page = Astro.props.entry;
const allLegal = Astro.props.legal;

// SEO
const fm = page.data;
const meta = fm.meta || {};
const { Content, headings } = await render(page);
const title = fm.title ? fm.title : 'Datum - Privacy Policy';
const description = fm.description;

// Sort side nav by frontmatter sidebar.order (content-editable, like handbook)
const sortedLegal = [...allLegal].sort(
  (a, b) => (a.data.sidebar?.order ?? 0) - (b.data.sidebar?.order ?? 0)
);

const navItems: LegalNavItem[] = sortedLegal.map((entry) => ({
  id: entry.id,
  title: entry.data.sidebar?.label || entry.data.title,
}));
---

<Layout
  title={title}
  description={description}
  bodyClass={`page-legal page-legal--${page.id}`}
  meta={meta}
>
  <section class="datum-container">
    <Hero
      class="light bg-glacier-mist-800 [&_.hero--main-content-title]:max-w-none"
      title={fm.title}
    />

    <div class="section--block section--block--small-pad bg-glacier-mist-700">
      <div class="max-width">
        <div class="legal-layout">
          <Sidebar items={navItems} currentId={page.id} />

          <main class="legal-content">
            <div class="legal-toc-reopen-row">
              <button
                type="button"
                class="legal-toc-reopen toc-pill-toggle"
                hidden
                aria-label="Show On This Page"
              >
                On This Page
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="toc-panel-chevron"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </button>
            </div>

            <Content />
          </main>

          <aside class="legal-toc">
            <TableOfContents
              headings={headings}
              title="On This Page"
              showTitle={true}
              sticky={true}
              collapsible={true}
              panelCollapsible={true}
            />
          </aside>
        </div>
      </div>
    </div>

    <Footer showCTA={false} />
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.querySelector<HTMLElement>('.legal-toc');
    const reopenButton = document.querySelector<HTMLButtonElement>('.legal-toc-reopen');
    if (!wrapper || !reopenButton) return;

    // Hiding the whole column (not just the nav inside it) lets .legal-content's
    // flex-1 reclaim that width — a wider content column wraps fewer lines, so
    // there's less overall page height to scroll through.
    window.addEventListener('datum:toc-panel-toggle', (event) => {
      const collapsed = (event as CustomEvent<{ collapsed: boolean }>).detail?.collapsed ?? false;
      wrapper.classList.toggle('is-hidden', collapsed);
      reopenButton.hidden = !collapsed;
    });

    reopenButton.addEventListener('click', () => {
      wrapper.classList.remove('is-hidden');
      reopenButton.hidden = true;
      window.dispatchEvent(new CustomEvent('datum:toc-panel-show'));
    });
  });
</script>
