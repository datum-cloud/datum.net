---
// src/pages/pricing.astro
// Public rate card — Figma node 16187:92970.
export const prerender = false;

import '@styles/page-pricing.css';

import Layout from '@layouts/Layout.astro';
import Announcement from '@components/Announcement.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import ModuleConnector from '@components/home/ModuleConnector.astro';
import Hero from '@components/pricing/Hero.astro';
import RateTables from '@components/pricing/RateTables.astro';
import Faq from '@components/pricing/Faq.astro';
import { getCollectionEntry } from '@utils/collectionUtils';
import { getCollection } from 'astro:content';
import { faqToPlainText } from '@utils/faqText';
import { prefooter } from '@data/pricing';

const page = await getCollectionEntry('pages', 'pricing');
const fm = page.data;
const meta = fm.meta || {};
const title = fm.title;

const faqs = (await getCollection('faq'))
  .filter((faq) => !faq.data.draft && faq.data.category === 'pricing')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://www.datum.net/pricing/#webpage',
      url: 'https://www.datum.net/pricing/',
      name: meta.title ?? title,
      description: fm.description,
      isPartOf: { '@id': 'https://www.datum.net/#organization' },
      inLanguage: 'en-US',
      dateModified: '2026-08-12',
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://www.datum.net/pricing/#faq',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.data.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faqToPlainText(faq.body ?? ''),
        },
      })),
    },
  ],
};
---

<Layout
  bodyClass="page-pricing"
  title={title}
  description={fm.description}
  meta={meta}
  jsonLd={jsonLd}
>
  <section class="datum-container">
    <header class="page-header">
      <Announcement />
      <Nav />
    </header>

    <div class="relative">
      <Hero />
      <RateTables />
      <Faq />

      <ModuleConnector />
    </div>

    <Footer
      ctaTitle={prefooter.title}
      ctaTitleAccent={prefooter.titleAccent}
      ctaDescription={prefooter.description}
      ctaButtons={prefooter.buttons}
    />
  </section>
</Layout>
