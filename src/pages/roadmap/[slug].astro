---
// src/pages/roadmap/[slug].astro
export const prerender = false;

const { slug } = Astro.params as { slug: string };
const suffix = slug.endsWith('.md') ? '.md' : '';
const base = suffix ? slug.slice(0, -suffix.length) : slug;

return Astro.redirect(base === 'backlog' ? `/roadmap${suffix}` : `/releases/${base}${suffix}`, 301);
---
